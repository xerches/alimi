# Copy to .env and fill in ONLY for tenants you own or have a signed pilot authorization for.
# Never commit .env. All scopes are read-only.

# Microsoft 365 (Entra app registration, application permissions, read-only)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Google Workspace (service account with domain-wide delegation, read-only scopes)
GWS_SERVICE_ACCOUNT_FILE=./secrets/gws-service-account.json
GWS_DELEGATED_ADMIN=admin@example.com
GWS_CUSTOMER_ID=my_customer
# Comma-separated OAuth client ids of third-party apps the company has approved (optional)
GWS_APPROVED_CLIENT_IDS=

# Scanner behaviour
ALIMI_MOCK=true
ALIMI_OUTPUT_DIR=./out

# Platform (prompt 12a, mock mode only). docker compose sets these itself; set them by hand only
# when running the app outside compose. Generate a token key with: python -m alimi_platform.crypto
ALIMI_MODE=mock
ALIMI_DATABASE_URL=postgresql+psycopg://alimi_app:alimi_app_local@localhost:5432/alimi
ALIMI_OWNER_DATABASE_URL=postgresql+psycopg://alimi_owner:alimi_owner_local@localhost:5432/alimi
ALIMI_TOKEN_KEY=
ALIMI_SESSION_SECRET=
