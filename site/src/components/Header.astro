---
import { brand } from "../lib/config.js";
const { current } = Astro.props;
const links = [
  { href: "/workspace-security-scan", label: "Security scan" },
  { href: "/policy-pack", label: "Policy pack" },
  { href: "/payment-fraud-kit", label: "Payment fraud kit" },
  { href: "/ai-policy-kit", label: "AI policy kit" },
  { href: "/for-partners", label: "For partners" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={`${brand.display_name} home`}>
      <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect class="brand__mark-back" x="7" y="2" width="15" height="15" rx="3" />
        <rect class="brand__mark-front" x="2" y="7" width="15" height="15" rx="3" />
      </svg>
      <span>{brand.display_name}</span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.href ? "page" : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
