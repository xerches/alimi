---
import { brand } from "../lib/config.js";
const { current } = Astro.props;
const links = [
  { href: "/platform", label: "Platform" },
  { href: "/pricing", label: "Pricing" },
  { href: "/compare", label: "Compare" },
  { href: "/for-partners", label: "For partners" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
const isCurrent = (href) => current === href || (href !== "/" && current.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label={`${brand.display_name} home`}>
      <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect class="brand__mark-back" x="7" y="2" width="15" height="15" rx="3" />
        <rect class="brand__mark-front" x="2" y="7" width="15" height="15" rx="3" />
      </svg>
      <span>{brand.display_name}</span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
