---
// The platform tiers from config/pricing.yaml. compact: name, size and price only, for the home page.
import { platform } from "../lib/config.js";
const { compact = false, cta = "/pricing#waitlist", ctaLabel = "Join the waitlist" } = Astro.props;
const { tiers } = platform();
---

<div class="tiers">
  {tiers.map((tier, index) => (
    <article class={index === 1 ? "card tier tier--featured" : "card tier"} aria-labelledby={`tier-${tier.id}`}>
      {index === 1 && <span class="badge">Most companies</span>}
      <h3 class="tier__name" id={`tier-${tier.id}`}>{tier.name}</h3>
      <p class="tier__meta">{tier.peopleLabel}</p>
      <p class="tier__price">{tier.price}<span class="tier__per"> a year</span></p>
      <p class="tier__note">{tier.monthly}, {tier.note.toLowerCase()}</p>
      {!compact && (
        <>
          <p class="tier__meta"><strong>Frameworks:</strong> {tier.frameworkLabels.join(", ")}. <strong>{tier.integrationsLabel}.</strong></p>
          <ul class="checklist">
            {tier.includes.map((item) => <li>{item}</li>)}
          </ul>
          <a class="button button--primary" href={cta}>{ctaLabel}</a>
        </>
      )}
    </article>
  ))}
</div>
