---
// Solutions: by who sent the buyer (the axis that fits 10 to 200 people), by industry, by company
// size, by framework. Added Nov 2, 2026 because both larger vendors segment this way and the founder
// asked for every section they have. Framework lists come from the catalog, never typed twice.
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import { brand, platform, framework, frameworkHref, quote, choosableFrameworks } from "../lib/config.js";

const plat = platform();
const [silver, gold, platinum] = plat.tiers;
const catalogCount = choosableFrameworks().length;
const fws = (ids) => ids.map((id) => ({ ...framework(id), href: frameworkHref(id) }));

const senders = [
  { id: "broker", title: "Your insurance broker sent you", text: `The renewal questionnaire is due and the premium depends on the answers: MFA, backups, endpoint protection, admin accounts. Start on ${silver.name} with the cyber insurance questionnaire as your framework; the report goes to the broker with the evidence attached.`, frameworks: fws(["insurer", "cis"]), tier: silver },
  { id: "accountant", title: "Your accountant mentioned it", text: "A near-miss on a fake invoice, or a question about controls at year end. The payment verification procedure, the finance lesson and the signed policies answer both, and the controls your CPA asks about exist and have an owner.", frameworks: fws(["insurer", "ftc_safeguards", "sox_itgc"]), tier: silver },
  { id: "customer", title: "A customer or your attorney asked for SOC 2 or ISO 27001", text: `A security clause in a contract, or a questionnaire from a customer's procurement team. ${gold.name} adds the second framework, the public trust page and questionnaire answers drafted from the evidence you already have.`, frameworks: fws(["soc2", "iso27001", "mvsp"]), tier: gold },
  { id: "provider", title: "Your IT provider runs it for you", text: `Many companies arrive through the MSP that already manages their Microsoft 365 or Google Workspace. The provider resells ${brand.display_name} under its own name, stays your first call, and sees every client's readiness on one screen; ${brand.display_name} is the second line.`, frameworks: fws(["insurer", "cis", "soc2"]), tier: silver, link: { href: "/for-resellers", label: "The reseller programme" } },
];

const industries = [
  { id: "healthcare", title: "Healthcare", text: "Clinics, practices, labs and the software and billing companies that serve them: the health-data rules, the hospital system's vendor questionnaire, and the insurer's questions on top.", frameworks: fws(["hipaa", "hitrust", "soc2", "insurer"]) },
  { id: "financial", title: "Financial services and insurance", text: "Insurance agencies, lenders, advisers, fintechs and their suppliers: the state and federal rules for licensed firms, the bank's supplier questionnaire, and the written programme the regulator expects.", frameworks: fws(["ftc_safeguards", "nydfs_500", "ffiec", "ofdss", "cri_profile", "pci_dss"]) },
  { id: "software", title: "Software and IT services", text: "SaaS companies, agencies and IT providers whose customers ask for a report before they sign: SOC 2 first, ISO 27001 for European customers, the enterprise buyer's baseline checklist.", frameworks: fws(["soc2", "iso27001", "mvsp", "aws_ftr", "csa_ccm", "iso42001"]) },
  { id: "professional", title: "Professional services", text: "Law firms, CPAs, consultancies, payroll and staffing companies: client confidentiality, the Massachusetts and state privacy rules, and the clause in the engagement letter that asks about security.", frameworks: fws(["ma_201_cmr_17", "ftc_safeguards", "us_state_privacy", "soc2", "insurer"]) },
  { id: "public", title: "Government suppliers", text: "Contractors and subcontractors to federal, state and defence customers, and vendors to police departments and courts: the control catalogs those customers require, in the order they are usually asked for.", frameworks: fws(["nist_800_171", "cmmc", "nist_800_53", "fedramp", "cjis"]) },
  { id: "manufacturing", title: "Manufacturing and logistics", text: "Suppliers to larger manufacturers, car makers and distributors: the customer's supplier assessment, continuity guarantees, and quality alongside security.", frameworks: fws(["tisax", "iso27001", "iso22301", "iso9001", "nis2"]) },
];

const sizes = [
  { range: "10 to 25 people", tier: silver, example: quote({ tierId: "silver", users: 25 }), text: "One insurer, one questionnaire, nobody whose job this is. The cyber insurance questionnaire as the framework, one integration, and the founder on a quarterly call." },
  { range: "25 to 100 people", tier: gold, example: quote({ tierId: "gold", users: 50 }), text: "A customer or two asking for SOC 2 or ISO 27001, vendors that hold your data, and the first security questionnaires. Two frameworks, the trust page and a monthly call." },
  { range: "100 to 200 people", tier: platinum, example: quote({ tierId: "platinum", users: 150, frameworks: 3 }), text: "Several frameworks, your own systems to connect, access reviews on a schedule and an AI programme to govern. Unlimited integrations and the API." },
];
---

<Base title="Solutions" description={`Alimi by who sent you (broker, accountant, customer, IT provider), by industry (healthcare, financial services, software, professional services, government suppliers, manufacturing), by company size and by framework, with the frameworks each usually needs from a catalog of ${catalogCount}.`} path="/solutions">
  <Hero eyebrow="Solutions" title="Start from the person who asked, the industry you are in, or the size you are">
    <p class="lede">Most companies of 10 to 200 people arrive with one request from one person: a broker, an accountant, a customer, an IT provider. Each path below says where to start and which frameworks usually follow.</p>
    <div class="actions">
      <a class="button button--primary" href="#sender">By who sent you</a>
      <a class="button button--secondary" href="#industry">By industry</a>
    </div>
  </Hero>

  <Section id="sender" tone="alt" title="By who sent you">
    <div class="grid grid--two">
      {senders.map((s) => (
        <article class="card" id={s.id}>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <p class="small"><strong>Usually starts on:</strong> {s.tier.name}, {s.tier.perUser} per user a month. <strong>Frameworks:</strong> {s.frameworks.map((f, i) => <>{i > 0 && ", "}<a href={f.href}>{f.short}</a></>)}.</p>
          {s.link && <p class="small"><a href={s.link.href}>{s.link.label}</a></p>}
        </article>
      ))}
    </div>
  </Section>

  <Section id="industry" title="By industry" lede="The frameworks named are the ones companies in each industry are usually asked for; one is included in every plan and the rest are add-ons.">
    <div class="grid grid--two">
      {industries.map((ind) => (
        <article class="card" id={ind.id}>
          <h3>{ind.title}</h3>
          <p>{ind.text}</p>
          <p class="small"><strong>Frameworks:</strong> {ind.frameworks.map((f, i) => <>{i > 0 && ", "}<a href={f.href}>{f.short}</a></>)}.</p>
        </article>
      ))}
    </div>
  </Section>

  <Section id="size" tone="alt" title="By company size" lede="Every tier is priced per user a month; the examples are one framework on the 12-month term unless stated.">
    <div class="grid">
      {sizes.map((s) => (
        <article class="card">
          <h3>{s.range}</h3>
          <p>{s.text}</p>
          <p class="small"><strong>{s.tier.name}</strong>, {s.tier.perUser} per user a month. Example: {s.example.seats} users{s.example.frameworks > 1 ? `, ${s.example.frameworks} frameworks` : ""}, {s.example.yearlyText}.</p>
        </article>
      ))}
    </div>
    <p style="margin-top:1.5rem"><a href="/pricing#calculator">Work out your own price</a></p>
  </Section>

  <Section id="frameworks" title="By framework" lede={`If you were asked for a framework by name, start there: ${catalogCount} in the catalog, each with a page that says who needs it, how Alimi handles it and what it costs.`}>
    <div class="actions">
      <a class="button button--primary" href="/frameworks">The framework catalog</a>
      <a class="button button--secondary" href="/contact">Not sure which one? Ask</a>
    </div>
  </Section>
</Base>
