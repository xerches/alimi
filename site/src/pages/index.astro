---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Steps from "../components/Steps.astro";
import Tiers from "../components/Tiers.astro";
import { brand, platform, freeResources } from "../lib/config.js";
import { policies, checkCounts, frameworks, controlSummary } from "../lib/content.js";

const { tiers } = platform();
const starter = tiers[0];
const policyCount = policies().length;
const checks = checkCounts();
const controls = controlSummary();
const frameworkCount = frameworks().length;

const modules = [
  { title: "Controls that check themselves", text: `${controls.total} controls, each with one owner and one status. ${controls.automated} are tested on every scan of your tenant; the rest are covered by evidence with a renewal date, so nothing quietly expires.` },
  { title: "Evidence with a renewal date", text: "Every screenshot, export and report is filed against the control it proves, with an owner and a date it goes stale. The export pack for a broker or auditor builds itself." },
  { title: "Policies your staff actually sign", text: `${policyCount} policies written for a company your size, mapped to the frameworks by criterion ID, with acknowledgement tracking and a yearly review.` },
  { title: "People and training", text: "One row per person, one column per check: policies accepted, training current, MFA registered, device compliant. A new hire sees their own checklist on day one." },
  { title: "Frameworks, insurer first", text: `The cyber insurance questionnaire first, then SOC 2, ISO 27001, HIPAA and ISO 42001: ${frameworkCount} frameworks, each answered by the same controls and policies.` },
  { title: "Vendors, risks and AI tools", text: "The vendors who hold your data, scored and reviewed; a risk register in plain sentences; an inventory of the AI tools in use and what changed at each vendor." },
  { title: "Trust page and questionnaires", text: "A public page a prospect or bank can read, and the next security questionnaire drafted from answers you already have." },
  { title: "An assistant that knows your program", text: "Ask in plain words which policy answers a question or what is due before the renewal. It reads your own data and shows its sources. In preview." },
];
const steps = [
  { title: "Connect, read-only", text: "A read-only connection to Microsoft 365 or Google Workspace, agreed in a one-page letter. alimi reads settings, never mail or files, and never holds a password." },
  { title: "Watch and fix", text: `${checks.total} checks run every week: MFA coverage, legacy sign-in, admin accounts, mail forwarding, sharing links, audit logs. A failing check becomes a task with an owner, a plain-English fix and a due date.` },
  { title: "Prove it", text: "Readiness per framework, an export pack for the broker or the auditor, a trust page for prospects, and questionnaire answers drafted from your own evidence." },
];
const differences = [
  { title: "A published price", text: `From ${starter.price} a year, on this site. The platforms built for larger companies quote by sales call and start around $12,000 to $15,000 a year for a twenty-person company.` },
  { title: "Insurer-ready first", text: "The first output is the evidence a broker or underwriter accepts. SOC 2 and ISO 27001 follow from the same work, when a customer asks for them." },
  { title: "Plain English", text: "Written for the owner who signs the renewal, not the auditor. Every term is explained the first time it appears: MFA, EDR, BEC." },
  { title: "A named compliance lead", text: "The scoping and policy calls that software leaves to you are made with you, by the person who built the platform." },
];
---

<Base title={brand.display_name} description={`${brand.tagline} alimi watches your Microsoft 365 or Google Workspace, keeps policies signed and evidence current, and turns it into the answers an insurer, a customer or an auditor asks for. Published prices from ${starter.price} a year.`} path="/">
  <Hero eyebrow="For companies that want a partner in security and compliance" title={brand.tagline}>
    <p class="lede">
      {brand.display_name} watches your Microsoft 365 or Google Workspace, keeps your policies signed and your evidence current, and turns it into the answers an insurer, a customer or an auditor asks for. Published prices from {starter.price} a year, and a named compliance lead who makes the calls software leaves to you.
    </p>
    <div class="actions">
      <a class="button button--primary" href="/pricing">See pricing</a>
      <a class="button button--secondary" href="/platform">How it works</a>
    </div>
    <p class="muted small" style="margin-top:1rem">Every connection is read-only. {brand.display_name} never holds your passwords.</p>
  </Hero>

  <Section id="modules" tone="alt" title="One place that knows whether your security is in order" lede="Continuous monitoring of your controls, evidence that renews itself, policies with sign-off, and the frameworks answered from the same work.">
    <div class="grid grid--two">
      {modules.map((m) => (
        <article class="card">
          <h3>{m.title}</h3>
          <p>{m.text}</p>
        </article>
      ))}
    </div>
    <p style="margin-top:1.5rem"><a href="/platform">Every module, in detail</a></p>
  </Section>

  <Section id="how" title="How it works">
    <Steps steps={steps} />
  </Section>

  <Section id="pricing" tone="alt" title="Published prices" lede="Three tiers by company size, billed yearly. Policies, people, evidence and the insurer questionnaire are in every one.">
    <Tiers compact />
    <div class="actions" style="margin-top:1.5rem">
      <a class="button button--primary" href="/pricing">Full pricing and services</a>
      <a class="button button--secondary" href="/for-partners">Reseller and referral terms</a>
    </div>
  </Section>

  <Section id="why" title="Why not one of the big platforms?" lede="They are good products for companies with a security owner and a budget to match. alimi is built for the companies they quote out of reach.">
    <div class="grid grid--two">
      {differences.map((d) => (
        <article class="card">
          <h3>{d.title}</h3>
          <p>{d.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section id="founder" tone="alt" title="Who is behind it">
    <p class="measure">
      {brand.display_name} is built by {brand.founder} in {brand.location}, after years of running SOC 2, ISO 27001 and HIPAA programs from the inside at a software company, a managed IT provider and a biopharma company. The companies that needed the most help were always the ones too small to hire him.
    </p>
    <a href="/about">More about {brand.display_name}</a>
  </Section>

  <Section id="start" tone="dark" title="Start free" lede="No card, no account. The free resources are the same documents the platform uses.">
    <ul class="checklist">
      {freeResources().map((r) => <li>{r.name}</li>)}
    </ul>
    <div class="actions" style="margin-top:1.5rem">
      <a class="button button--primary" href="/resources">Free resources</a>
      <a class="button button--secondary" href="/pricing#waitlist">Join the waitlist</a>
    </div>
  </Section>
</Base>
