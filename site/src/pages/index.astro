---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Steps from "../components/Steps.astro";
import Tiers from "../components/Tiers.astro";
import { brand, decided, platform, choosableFrameworks, alwaysIncludedFrameworks, quote } from "../lib/config.js";

const plat = platform();
const silver = plat.tiers[0];
const gold = plat.tiers[1];
const demo = decided(brand.demo_url);
const frameworkCount = choosableFrameworks().length;
const posture = alwaysIncludedFrameworks()[0];
const example = quote({ tierId: "silver", users: 25 });

// One line per module; the detail is on /platform. No scalable count appears on the site (founder's rule, Nov 2, 2026).
const modules = [
  { href: "/platform#controls", title: "Controls that check themselves", text: "Each control has one owner and one status, tested on every scan of your tenant or covered by evidence with a renewal date, so nothing quietly expires." },
  { href: "/platform#evidence", title: "Evidence with a renewal date", text: "Every screenshot, export and report is filed against the control it proves. The export pack for a broker or auditor builds itself." },
  { href: "/platform#policies", title: "Policies your staff actually sign", text: "A policy library written for a company your size, mapped to the frameworks by criterion ID, with acknowledgement tracking and a yearly review." },
  { href: "/platform#people", title: "People and training", text: "One row per person, one column per check, and short security lessons with a quiz, so the insurer's training question has a date behind it." },
  { href: "/frameworks", title: "Frameworks, insurer first", text: `${frameworkCount} frameworks in the catalog, one included, each answered by the same controls and policies.` },
  { href: "/frameworks", title: "A security score, not only a compliance score", text: `The ${posture.name} is in every plan, so you can see the gap between passing the audit and being hard to break into.` },
  { href: "/platform#vendors", title: "Vendors, risks and AI tools", text: "The vendors who hold your data, scored and reviewed; a risk register in plain sentences; an inventory of the AI tools in use." },
  { href: "/platform#trust", title: "Trust page and questionnaires", text: `A public page a prospect or bank can read, and the next security questionnaire drafted from answers you already have, from the ${gold.name} tier.` },
  { href: "/platform#assistant", title: "An assistant that drafts; you decide", text: "It reads your own data, shows its sources on every line, and never changes a record on its own. In preview." },
];
const steps = [
  { title: "Connect, read-only", text: "A read-only connection to Microsoft 365 or Google Workspace, agreed in a one-page letter. Alimi reads settings, never mail or files, and never holds a password." },
  { title: "Watch and fix", text: "Checks run every week: MFA coverage, legacy sign-in, admin accounts, mail forwarding, sharing links, audit logs. A failing check becomes a task with an owner, a plain-English fix and a due date." },
  { title: "Prove it", text: "Readiness per framework, an export pack for the broker or the auditor, a trust page for prospects, and questionnaire answers drafted from your own evidence." },
];
const audiences = [
  { href: "/solutions#broker", title: "Your insurance broker sent you", text: `The renewal questionnaire is due and the premium depends on the answers: MFA, backups, endpoint protection, admin accounts. Start on ${silver.name} with the cyber insurance questionnaire as your framework; the report goes to the broker with the evidence attached.` },
  { href: "/solutions#accountant", title: "Your accountant mentioned it", text: "A near-miss on a fake invoice, or a question about controls at year end. The payment verification procedure, the finance lesson and the signed policies answer both, and the controls your CPA asks about exist and have an owner." },
  { href: "/solutions#customer", title: "A customer or your attorney asked for SOC 2 or ISO 27001", text: `A security clause in a contract, or a questionnaire from a customer's procurement team. ${gold.name} adds the second framework, the public trust page and questionnaire answers drafted from the evidence you already have.` },
  { href: "/solutions#provider", title: "Your IT provider runs it for you", text: "Many companies arrive through the MSP that already manages their Microsoft 365 or Google Workspace. The provider resells Alimi under its own name, stays your first call, and sees every client's readiness on one screen; Alimi is the second line." },
];
const differences = [
  { title: "A published price, per user", text: `From ${silver.perUser} per user a month, on this site: ${example.yearlyText} for a 25-person company. The platforms built for larger companies quote by sales call and start around $12,000 to $15,000 a year for the same company.` },
  { title: "Insurer-ready first", text: "The first output is the evidence a broker or underwriter accepts. SOC 2 and ISO 27001 follow from the same work, when a customer asks for them." },
  { title: "Plain English", text: "Written for the owner who signs the renewal, not the auditor. Every term is explained the first time it appears: MFA, EDR, BEC." },
  { title: "A named compliance lead", text: "The scoping and policy calls that software leaves to you are made with you, by the person who built the platform." },
];
---

<Base title={brand.display_name} description={`${brand.tagline} Alimi watches your Microsoft 365 or Google Workspace, keeps policies signed and evidence current, and turns it into the answers an insurer, a customer or an auditor asks for. Published prices from ${silver.perUser} per user a month.`} path="/">
  <Hero eyebrow="For companies that want a partner in security and compliance" title={brand.tagline}>
    <p class="lede">
      {brand.display_name} watches your Microsoft 365 or Google Workspace, keeps your policies signed and your evidence current, and turns it into the answers an insurer, a customer or an auditor asks for. Published prices from {silver.perUser} per user a month, and a named compliance lead who makes the calls software leaves to you.
    </p>
    <div class="actions">
      <a class="button button--primary" href="/pricing">See pricing</a>
      <a class="button button--secondary" href="/platform">How it works</a>
    </div>
    <p class="muted small" style="margin-top:1rem">Every connection is read-only. {brand.display_name} never holds your passwords.</p>
    {demo && <p class="small" style="margin-top:0.5rem"><a href={demo} rel="noopener">See the product: a sample company you can click through, no sign-up and no sales call</a></p>}
  </Hero>

  <Section id="modules" tone="alt" title="One place that knows whether your security is in order" lede="Continuous monitoring of your controls, evidence that renews itself, policies with sign-off, and the frameworks answered from the same work.">
    <div class="grid grid--two">
      {modules.map((m) => (
        <a class="card card--link" href={m.href}>
          <h3>{m.title}</h3>
          <p>{m.text}</p>
        </a>
      ))}
    </div>
    <p style="margin-top:1.5rem"><a href="/platform">Every module, in detail</a></p>
  </Section>

  <Section id="how" title="How it works">
    <Steps steps={steps} />
  </Section>

  <Section id="pricing" tone="alt" title="Published prices" lede={`Four tiers, per user a month, paid monthly on a 12-month term or month to month. One framework is included in every one, with ${frameworkCount} to choose from, and the policy library, training and a named compliance lead come with all of them.`}>
    <Tiers compact />
    <div class="actions" style="margin-top:1.5rem">
      <a class="button button--primary" href="/pricing">Full pricing and services</a>
      <a class="button button--secondary" href="/pricing#calculator">Work out your price</a>
    </div>
  </Section>

  <Section id="why" title="Why not one of the big platforms?" lede="They are good products for companies with a security owner and a budget to match. Alimi is built for the companies they quote out of reach.">
    <div class="grid grid--two">
      {differences.map((d) => (
        <article class="card">
          <h3>{d.title}</h3>
          <p>{d.text}</p>
        </article>
      ))}
    </div>
    <p style="margin-top:1.5rem"><a href="/compare">Alimi, Vanta and Drata compared on what their customers complain about</a></p>
  </Section>

  <Section id="who" title="Who it is for" lede="Most companies arrive through someone they already trust. Here is what each of them is trying to solve, and where to start.">
    <div class="grid grid--two">
      {audiences.map((a) => (
        <a class="card card--link" href={a.href}>
          <h3>{a.title}</h3>
          <p>{a.text}</p>
        </a>
      ))}
    </div>
    <p style="margin-top:1.5rem"><a href="/solutions">Solutions by industry and company size</a>, and <a href="/for-partners">for the brokers, accountants, attorneys and IT providers who refer or resell</a></p>
  </Section>

  <Section id="founder" tone="alt" title="Who is behind it">
    <p class="measure">
      {brand.display_name} is built by {brand.founder} in {brand.location}, after years of running SOC 2, ISO 27001 and HIPAA programs from the inside at a software company, a managed IT provider and a biopharma company. The companies that needed the most help were always the ones too small to hire him.
    </p>
    <a href="/about">More about {brand.display_name}</a>
  </Section>

  <Section id="start" tone="dark" title="Start with the price" lede="Enter your headcount and the frameworks you need; the total is on the page, not in a sales call. Pilots open in January 2027.">
    <div class="actions" style="margin-top:0.5rem">
      <a class="button button--primary" href="/pricing#calculator">Work out your price</a>
      <a class="button button--secondary" href="/pricing#waitlist">Join the waitlist</a>
      {demo && <a class="button button--secondary" href={demo} rel="noopener">See the product</a>}
    </div>
  </Section>
</Base>
