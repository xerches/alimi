---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Steps from "../components/Steps.astro";
import Tiers from "../components/Tiers.astro";
import { brand, decided, platform, choosableFrameworks, alwaysIncludedFrameworks, quote } from "../lib/config.js";

const plat = platform();
const silver = plat.tiers[0];
const gold = plat.tiers[1];
const demo = decided(brand.demo_url);
const frameworkCount = choosableFrameworks().length;
const posture = alwaysIncludedFrameworks()[0];
const example = quote({ tierId: "silver", users: 25 });

// The hero shows the product itself (Nov 3, 2026): the app's Home for the demo's sample company, in a
// frame beside the copy. The month's list, the renewal countdown and the two scores are the demo's own
// figures (Saltmarsh Payroll, scan of Oct 30, 2026), labelled as a sample, and name no control count.
const sample = {
  company: "Saltmarsh Payroll",
  asOf: "Nov 1, 2026",
  month: "November 2026",
  renewalDays: 75,
  packDays: 44,
  readiness: "80%",
  month_items: [
    { title: "Get five people registered for MFA", owner: "The IT lead", time: "about 20 minutes", why: "Clears a failing test the insurer asks about first", status: "Test failing", tone: "bad" },
    { title: "Attach this quarter's vulnerability scan report", owner: "The IT lead", time: "5 minutes", why: "Overdue since September", status: "Needs evidence", tone: "warn" },
    { title: "Name an owner for the retention and office-access controls", owner: "Operations", time: "5 minutes", why: "Nothing gets done on a control nobody owns", status: "Needs owner", tone: "warn" },
  ],
};

// One line per module; the detail is on /platform. No scalable count appears on the site (founder's rule, Nov 2, 2026).
const modules = [
  { href: "/platform/controls", title: "Controls that check themselves", text: "An owner and a status per control, tested on every scan or proven by evidence with a renewal date." },
  { href: "/platform/evidence", title: "Evidence with a renewal date", text: "Every export and screenshot is filed against the control it proves; the broker's pack builds itself." },
  { href: "/platform/policies", title: "Policies your staff actually sign", text: "Written for your size, mapped by criterion ID, with sign-off tracking and a yearly review." },
  { href: "/platform/people", title: "People and training", text: "One row per person, short lessons with a quiz, and a date behind the insurer's training question." },
  { href: "/frameworks", title: "Frameworks, insurer first", text: `${frameworkCount} frameworks in the catalog, one included, all answered by the same controls.` },
  { href: "/frameworks", title: "A security score, not only a compliance score", text: `The ${posture.name}, in every plan: the gap between passing the audit and being hard to break into.` },
  { href: "/platform/vendors", title: "Vendors, risks and AI tools", text: "The vendors who hold your data, a risk register in plain sentences, and the AI tools in use." },
  { href: "/platform/trust", title: "Trust page and questionnaires", text: `A page a prospect can read, and questionnaires drafted from answers you already have, from ${gold.name}.` },
  { href: "/platform/assistant", title: "An assistant that drafts; you decide", text: "Reads your data, cites a source on every line, never changes a record on its own. In preview." },
];
const steps = [
  { title: "Connect, read-only", text: "A read-only connection to Microsoft 365 or Google Workspace, agreed in a one-page letter. Alimi reads settings, never mail, files or passwords." },
  { title: "Watch and fix", text: "Weekly checks on MFA (the second step at sign-in), legacy sign-in, admin accounts, mail forwarding and sharing links. A failing check becomes a task with an owner and a due date." },
  { title: "Prove it", text: "Readiness per framework, an export pack for the broker or the auditor, a trust page, and questionnaire answers drafted from your own evidence." },
];
// The "built on" band (Nov 5, 2026, after the Drata review): what the platform reads and runs on, named as text,
// in place of the customer logos every larger vendor shows, until the pilots produce a case study. Future tense
// for the hosted platform, which holds no customer data yet.
const builtOn = [
  { name: "Microsoft Graph", text: "How the platform will read your Microsoft 365: settings and directory data, read-only." },
  { name: "Google Admin SDK", text: "How it will read your Google Workspace, through a read-only service account." },
  { name: "Netlify", text: "Serves this site and the product demo, with a strict content security policy and no cookies." },
];
const audiences = [
  { href: "/solutions#broker", title: "Your insurance broker sent you", text: `The renewal questionnaire is due and the premium depends on the answers. Start on ${silver.name} with the insurance questionnaire; the report goes to the broker with the evidence.` },
  { href: "/solutions#accountant", title: "Your accountant mentioned it", text: "A near-miss on a fake invoice, or a question about controls at year end. The payment verification procedure and the signed policies answer both." },
  { href: "/solutions#customer", title: "A customer or your attorney asked for SOC 2 or ISO 27001", text: `A security clause in a contract, or a procurement questionnaire. ${gold.name} adds a second framework, the trust page and drafted answers.` },
  { href: "/solutions#provider", title: "Your IT provider runs it for you", text: "The provider that manages your Microsoft 365 or Google Workspace resells Alimi under its own name, stays your first call and sees every client on one screen." },
];
const differences = [
  { title: "A published price, per user", text: `From ${silver.perUser} per user a month, ${example.yearlyText} for 25 people, on this site. The platforms built for larger companies quote by sales call, from about $12,000 a year.` },
  { title: "Insurer-ready first", text: "The first output is what a broker or underwriter accepts. SOC 2 and ISO 27001 follow from the same work when a customer asks." },
  { title: "Plain English", text: "Written for the owner who signs the renewal, not the auditor, with every term explained the first time it appears." },
  { title: "A named compliance lead", text: "The scoping and policy calls software leaves to you are made with you, by the person who built the platform." },
];
---

<Base title={brand.display_name} description={`${brand.tagline} Alimi watches your Microsoft 365 or Google Workspace, keeps policies signed and evidence current, and turns it into the answers an insurer, a customer or an auditor asks for. Published prices from ${silver.perUser} per user a month.`} path="/">
  <section class="hero hero--split">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow">The compliance platform for companies without a security team</span>
        <h1>{brand.tagline}</h1>
        <p class="lede">
          {brand.display_name} watches your Microsoft 365 or Google Workspace, keeps policies signed and evidence current, and turns it into the answers an insurer, a customer or an auditor asks for. Published prices from {silver.perUser} per user a month, a named compliance lead included.
        </p>
        <div class="actions">
          <a class="button button--primary" href="/pricing">See pricing</a>
          <a class="button button--secondary" href="/platform">How it works</a>
        </div>
        <p class="muted small hero__note">Every connection is read-only. {brand.display_name} never holds your passwords.</p>
      </div>

      <div class="hero__product">
        <div class="frame" role="group" aria-label={`What the owner sees: the home screen of the sample company ${sample.company}`}>
          <div class="frame__bar">
            <span class="frame__mark" aria-hidden="true">{brand.display_name.slice(0, 1)}</span>
            <span class="frame__crumbs"><b>{sample.company}</b><span>Home</span></span>
            <span class="frame__tag">Sample</span>
          </div>
          <div class="frame__body">
            <div class="count">
              <span class="count__big">{sample.renewalDays}<small>days to the insurance renewal</small></span>
              <span class="count__sub">The broker wants the evidence pack in {sample.packDays} days.</span>
              <span class="count__accent">On track if this month's three items get done.</span>
            </div>
            <div class="frame__tiles">
              <div class="tile tile--score">
                <span class="tile__label">Audit readiness, insurer questionnaire</span>
                <span class="tile__value">{sample.readiness}</span>
                <span class="meter" aria-hidden="true"><span class="meter__fill" style={`--value:${sample.readiness}`}></span></span>
                <span class="tile__note">Requirements whose controls are in order, computed from the last scan.</span>
              </div>
              <div class="tile tile--alt">
                <span class="tile__label">{posture.name}</span>
                <span class="tile__value tile__value--text">In every plan</span>
                <span class="tile__note">Our recommendations beyond any framework, scored on every scan. Not a certification.</span>
              </div>
            </div>
            <div class="card frame__card">
              <div class="card__head">
                <p class="h3">{sample.month}</p>
                <span class="muted">Picked by impact on the renewal</span>
              </div>
              <ol class="todo-list">
                {sample.month_items.map((item) => (
                  <li>
                    <span class="todo__title">{item.title}</span>
                    <span class="todo__meta"><span><b>{item.owner}</b> · {item.time}</span><span>{item.why}</span></span>
                    <span class={`pill pill--${item.tone}`}>{item.status}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>
        <p class="sample__caption">Sample company from the product demo, data as of {sample.asOf}. Not a customer. Every status is computed from the scan, the evidence and the policies, never typed in.{demo && <> <a href={demo} rel="noopener">Click through the sample company</a>.</>}</p>
      </div>
    </div>
  </section>

  <Section id="modules" tone="alt" title="One place that knows whether your security is in order" lede="Controls monitored continuously, evidence that renews itself, policies with sign-off, frameworks answered from the same work.">
    <div class="grid grid--two">
      {modules.map((m) => (
        <a class="card card--link" href={m.href}>
          <h3>{m.title}</h3>
          <p>{m.text}</p>
        </a>
      ))}
    </div>
    <p style="margin-top:1.5rem"><a href="/platform">Every module, in detail</a></p>
  </Section>

  <Section id="how" title="How it works">
    <Steps steps={steps} />
  </Section>

  <Section id="built-on" tone="alt" tight>
    <div class="built-on">
      <div class="built-on__intro">
        <span class="eyebrow">Built on</span>
        <p class="muted">No customer logos yet, by rule: the first case studies arrive with the pilots in 2027. What the platform is built on is public now.</p>
      </div>
      <ul class="built-on__list">
        {builtOn.map((b) => (
          <li class="tile">
            <span class="tile__value tile__value--text">{b.name}</span>
            <span class="tile__note">{b.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section id="pricing" tone="alt" title="Published prices" lede={`Four tiers, per user a month, one framework included in each with ${frameworkCount} to choose from. The policy library, training and a named compliance lead come with all of them.`}>
    <Tiers compact />
    <div class="actions" style="margin-top:1.5rem">
      <a class="button button--primary" href="/pricing">Full pricing and services</a>
      <a class="button button--secondary" href="/pricing#calculator">Work out your price</a>
    </div>
  </Section>

  <Section id="why" title="Why not one of the big platforms?" lede="Good products for companies with a security owner and a budget to match. Alimi is for the companies they quote out of reach.">
    <div class="grid grid--two">
      {differences.map((d) => (
        <article class="card">
          <h3>{d.title}</h3>
          <p>{d.text}</p>
        </article>
      ))}
    </div>
    <p style="margin-top:1.5rem"><a href="/compare">Alimi, Vanta and Drata compared</a></p>
  </Section>

  <Section id="who" title="Who it is for" lede="Most companies arrive through someone they already trust. Where each one starts.">
    <div class="grid grid--two">
      {audiences.map((a) => (
        <a class="card card--link" href={a.href}>
          <h3>{a.title}</h3>
          <p>{a.text}</p>
        </a>
      ))}
    </div>
    <p style="margin-top:1.5rem"><a href="/solutions">Solutions by industry and company size</a>, and <a href="/for-partners">for the partners who refer or resell</a></p>
  </Section>

  <Section id="founder" tone="alt" title="Who is behind it">
    <p class="measure">
      {brand.display_name} is built by {brand.founder} in {brand.location}, after years running SOC 2, ISO 27001 and HIPAA programs inside a software company, an IT provider and a biopharma company. The companies that needed the most help were too small to hire him.
    </p>
    <a href="/about">More about {brand.display_name}</a>
  </Section>

  <Section id="start" tone="dark" title="Start with the price" lede="Your headcount and frameworks in, the total out, no sales call. Pilots open in January 2027.">
    <div class="actions" style="margin-top:0.5rem">
      <a class="button button--primary" href="/pricing#calculator">Work out your price</a>
      <a class="button button--secondary" href="/pricing#waitlist">Join the waitlist</a>
      {demo && <a class="button button--secondary" href={demo} rel="noopener">See the product</a>}
    </div>
  </Section>
</Base>
