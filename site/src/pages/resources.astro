---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import { brand, freeResources } from "../lib/config.js";
import { freeDocs } from "../lib/content.js";

const docs = freeDocs();
const groups = [...new Set(docs.map((d) => d.group))].map((group) => ({ group, docs: docs.filter((d) => d.group === group) }));
const scan = freeResources().find((r) => r.id === "scan_summary");
---

<Base title="Free resources" description="Free from Alimi, no card and no account: three core security policies, an AI acceptable use policy, the payment fraud procedure with callback scripts, poster and closing-day checklist, and a one-page security scan summary." path="/resources">
  <Hero eyebrow="Free resources" title="Start with these. No card, no account.">
    <p class="lede">The same documents the platform uses, free to read, print and adopt. Each one carries a template notice: adapt it to your company before you sign it, and have the marked sections reviewed by HR or a lawyer where it says so.</p>
    <div class="actions">
      <a class="button button--primary" href="#documents">The documents</a>
      <a class="button button--secondary" href="#files">Get the editable files</a>
    </div>
  </Hero>

  <Section id="documents" tone="alt" title="Policies and procedures">
    <div class="grid grid--two">
      {groups.map((g) => (
        <article class="card">
          <h3>{g.group}</h3>
          <ul>
            {g.docs.map((d) => (
              <li><a href={`/resources/${d.slug}`}>{d.title}</a> <span class="muted small">({d.id})</span></li>
            ))}
          </ul>
        </article>
      ))}
      <article class="card">
        <h3>{scan.name}</h3>
        <p>{scan.includes.join(". ")}. Run read-only by {brand.display_name} on your Microsoft 365 or Google Workspace under a one-page authorization letter, and returned as one page you can hand to your broker.</p>
        <a href="/contact">Ask for a free summary</a>
      </article>
    </div>
  </Section>

  <Section id="files" title="Get the editable files" lede="The pages above are the policies as written. For the DOCX versions with your company name filled in, and a note when a document changes, leave an address.">
    <WaitlistForm name="resources" title="Send me the files" intro="One email with the files, and one when a document changes. Nothing else." interest="resources" button="Send the files" />
  </Section>
</Base>
