---
// Press: boilerplate, facts, the founder in one paragraph, and the media contact. No coverage yet,
// and the page says so. Added Nov 2, 2026.
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import { brand, platform, choosableFrameworks } from "../lib/config.js";

const plat = platform();
const silver = plat.tiers[0];
const catalogCount = choosableFrameworks().length;
const facts = [
  { label: "What", value: "A security and compliance platform for companies of 10 to 200 people" },
  { label: "Where", value: brand.location },
  { label: "Founded", value: "2026, by " + brand.founder },
  { label: "Price", value: `Published, from ${silver.perUser} per user a month` },
  { label: "Frameworks", value: `${catalogCount} in the catalog, one included in every plan` },
  { label: "Stage", value: "Pre-launch; pilots open January 2027" },
];
---

<Base title="Press" description="Press information for Alimi: boilerplate, facts, the founder's biography and the media contact. No coverage yet; the company is pre-launch." path="/press">
  <Hero eyebrow="Press" title="News, boilerplate and the media contact">
    <p class="lede">{brand.display_name} is pre-launch and has had no press coverage yet. What a journalist needs is on this page; the founder answers questions personally.</p>
    <div class="actions">
      <a class="button button--primary" href="/contact">Media contact</a>
    </div>
  </Hero>

  <Section id="boilerplate" tone="alt" title="Boilerplate">
    <p class="measure">{brand.display_name} is a security and compliance platform for companies of 10 to 200 people that cannot hire a security team. It watches a company's Microsoft 365 or Google Workspace through a read-only connection, keeps its policies signed and its evidence current, and turns that into the answers an insurer, a customer or an auditor asks for, with the founder included as the compliance lead. Prices are published per user a month. {brand.display_name} is based in {brand.location} and was founded in 2026 by {brand.founder}.</p>
  </Section>

  <Section id="facts" title="Facts">
    <dl class="facts">
      {facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="founder" tone="alt" title="The founder">
    <p class="measure">{brand.founder} has run security and compliance programs from the inside for his whole career: as Information Security Manager at Exclaimer, a software company, where the SOC 2 and ISO 27001 programs underpinned customer deals; at Boston IT Services, a managed IT provider, where he built the security practice for client companies of 10 to 200 people; and today in security at a biopharma company. He holds the Security+ and CySA+ certifications and works in English, French and Russian.</p>
  </Section>

  <Section id="assets" title="Name and mark">
    <p class="measure">The name is written {brand.display_name}, with a capital A. The mark is two overlapping squares. Logo files arrive with the domain; until then, please use the name in text.</p>
  </Section>

  <Section id="news" tone="alt" title="News">
    <p class="measure">None yet. Launch, the first pilots and the first partner programme will be announced here and nowhere first.</p>
  </Section>

  <Section id="contact" tone="dark" title="Media contact" lede="Questions, interviews and corrections go to the founder. A reply within two business days.">
    <div class="actions">
      <a class="button button--primary" href="/contact">Contact</a>
    </div>
  </Section>
</Base>
