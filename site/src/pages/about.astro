---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import { brand } from "../lib/config.js";

const rules = [
  { title: "Read-only, always", text: "Every integration uses read-only permissions, listed in the documentation before you approve them. Alimi never holds a customer's passwords, and connection tokens are encrypted with a key kept outside the database." },
  { title: "Only tenants with a signed letter", text: "No scan runs without a signed authorization letter, however friendly the request." },
  { title: "Plain English", text: "Every term is explained the first time it appears: MFA, EDR, BEC. Reports are written for the owner who signs the renewal." },
  { title: "Honest claims", text: "Results from past employment are described as such. There will be case studies when there are clients, and not before." },
  { title: "No framework text", text: "Policies and reports map to SOC 2 and ISO 27001 by criterion number and our own summaries. The standards themselves are copyrighted and are never copied in." },
  { title: "One company per query", text: "Every query in the platform is scoped to one organization and enforced in the database, so a bug cannot show one company another's data." },
];
---

<Base title="About" description="Alimi is built in Boston by Alex Dennis: a compliance platform for companies of 10 to 200 people that cannot hire a security team, with the founder as the compliance lead. Who is behind it and the rules it works by." path="/about">
  <Hero eyebrow="About" title={brand.tagline_alt}>
    <p class="lede">{brand.display_name} is built in {brand.location} by {brand.founder}, for the owner or operations lead who has to answer an insurer, a customer or a bank, and has no one to hand it to.</p>
  </Hero>

  <Section id="founder" tone="alt" title="Who is behind it">
    <p class="measure">
      I am {brand.founder}. I have spent my career running security and compliance programs from the inside. As Information Security Manager at Exclaimer, a software company, I ran the SOC 2 and ISO 27001 programs that customer deals depended on. At Boston IT Services, a managed IT provider, I built the security practice for client companies of exactly the size {brand.display_name} serves. Today I work in security at a biopharma company, with SOC 2, ISO 27001, ISO 27018, HIPAA, GDPR and ISO 42001 behind me.
    </p>
    <p class="measure">
      The pattern was the same everywhere: the companies that needed the most help were the ones too small to hire me, and the platforms built for larger companies quoted them out of reach. {brand.display_name} is the platform I wished I could have handed them, with the scoping and policy calls made by a person rather than left to a checklist. I work in English, French and Russian.
    </p>
  </Section>

  <Section id="status" title="Where Alimi is today">
    <p class="measure">{brand.display_name} is a working name for a company in formation. Until the entity and insurance exist, the work is limited to building the platform in the open, free pilots under a signed authorization letter, and conversations with the brokers, accountants, attorneys and IT providers whose clients ask them about security. Prices are published now so that nobody has to ask.</p>
    <p class="measure">The code is public: <a href={brand.social.github} rel="noopener">{brand.social.github.replace("https://", "")}</a>.</p>
  </Section>

  <Section id="rules" tone="alt" title="The rules it works by">
    <div class="grid">
      {rules.map((r) => (
        <article class="card">
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section id="contact" tone="dark" title="Talk to the founder" lede="Questions about a renewal, a questionnaire or a partnership go to the person who will answer them.">
    <div class="actions">
      <a class="button button--primary" href="/contact">Contact</a>
      <a class="button button--secondary" href="/for-partners">For partners</a>
    </div>
  </Section>
</Base>
