---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Todo from "../components/Todo.astro";
import { brand } from "../lib/config.js";

const rules = [
  { title: "Read-only, always", text: "Scans use read-only permissions, listed in each tool's documentation. alimi never holds a customer's passwords, and tokens are never stored." },
  { title: "Only tenants with a signed letter", text: "No scan runs without a signed authorization letter, however friendly the request." },
  { title: "Plain English", text: "Every term is explained the first time it appears: MFA, EDR, BEC. Reports are written for the owner who signs the renewal." },
  { title: "Honest claims", text: "Results from past employment are described as such. There will be case studies when there are clients, and not before." },
  { title: "No framework text", text: "Policies and reports map to SOC 2 and ISO 27001 by criterion number and our own summaries. The standards themselves are copyrighted and are never copied in." },
];
---

<Base title="About" description="alimi is built in Boston by Alex Dennis for companies of 10 to 200 people that cannot hire a security team. How it works, who is behind it, and the rules it works by." path="/about">
  <Hero eyebrow="About" title={brand.tagline_alt}>
    <p class="lede">{brand.display_name} is built in {brand.location} by {brand.founder}, for the owner or operations lead who has to answer an insurer, a customer or a bank, and has no one to hand it to.</p>
  </Hero>

  <Section id="founder" tone="alt" title="Who is behind it">
    <p class="measure">
      I am {brand.founder}. I have run security and compliance programs from the inside at a biopharma company, a software company and a managed IT provider, covering SOC 2, ISO 27001, ISO 27018, HIPAA, GDPR and ISO 42001. The companies that needed the most help were always the ones too small to hire me. {brand.display_name} is the toolkit I wished I could have handed them.
      <Todo note="rewrite in first person, 150 words; name employers and attribute each metric to the role, after checking the current employer's outside-work clause (prompt 11)" />
    </p>
    <p class="measure">I work in English, French and Russian.</p>
  </Section>

  <Section id="status" title="Where alimi is today">
    <p class="measure">{brand.display_name} is a working name for a company in formation. Until the entity and insurance exist, the work is limited to building the products in the open, free pilots under a signed authorization letter, and conversations with the brokers, accountants, attorneys and IT providers whose clients ask them about security. Prices are published now so that nobody has to ask.</p>
    <p class="measure">The code is public: <a href={brand.social.github} rel="noopener">{brand.social.github.replace("https://", "")}</a>.</p>
  </Section>

  <Section id="rules" tone="alt" title="The rules it works by">
    <div class="grid">
      {rules.map((r) => (
        <article class="card">
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section id="contact" tone="dark" title="Talk to the founder" lede="Questions about a renewal, a questionnaire or a partnership go to the person who will answer them.">
    <div class="actions">
      <a class="button button--primary" href="/contact">Contact</a>
      <a class="button button--secondary" href="/for-partners">For partners</a>
    </div>
  </Section>
</Base>
