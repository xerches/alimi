---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import { MAIN_PAGES } from "../lib/nav.js";
---

<Base title="Page not found" description="That page does not exist on Alimi. The platform, frameworks, solutions, pricing, the comparison with Vanta and Drata, partner terms, resources and the contact page are one click away." path="/404">
  <Hero eyebrow="404" title="That page is not here">
    <p class="lede">The address may have changed while the site is in beta. The main pages are linked below, and the menus at the top list everything.</p>
    <div class="actions">
      <a class="button button--primary" href="/">Home</a>
      <a class="button button--secondary" href="/contact">Contact</a>
    </div>
  </Hero>
  <Section id="links" tone="alt" title="Pages">
    <ul>
      {MAIN_PAGES.map((p) => (
        <li><a href={p.href}>{p.label}</a></li>
      ))}
    </ul>
  </Section>
</Base>
