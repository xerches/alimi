---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Steps from "../components/Steps.astro";
import Pricing from "../components/Pricing.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import Callout from "../components/Callout.astro";
import Todo from "../components/Todo.astro";
import { product } from "../lib/config.js";
import { policies } from "../lib/content.js";

const p = product("policy_pack");
const list = policies();
const steps = [
  { title: "Start with the three core policies", text: "Information security, acceptable use and incident response, free. They answer the first three questions a customer or insurer asks." },
  { title: "Get the full library with your name filled in", text: "Every policy as DOCX and PDF with the company name and owner roles filled, plus the coverage matrix that shows which requirement each policy satisfies." },
  { title: "Adopt it, with help if you want it", text: "Each file says which sections need HR or legal review. The adoption workshop tailors, approves and rolls out the set in half a day and sets up staff acknowledgement tracking." },
];
---

<Base title={p.name} description="Security and company policies written for a 10 to 200 person company, mapped by criterion ID to SOC 2, ISO 27001, ISO 42001 and the cyber insurance questionnaire. Three policies free; the full library at a published price." path={p.href}>
  <Hero eyebrow={p.name} title={p.tagline}>
    <p class="lede">{list.length} policies in plain English, mapped by criterion ID to SOC 2, ISO 27001, ISO 42001, the HIPAA Security Rule where it applies, and the questions on a cyber insurance application.</p>
    <div class="actions">
      <a class="button button--primary" href="#waitlist">Join the waitlist</a>
      <a class="button button--secondary" href="#pricing">See pricing</a>
    </div>
  </Hero>

  <Section id="complaint" tone="alt" title="The policies exist on a template site. Yours do not.">
    <p class="measure">
      A customer's security review asks for your information security policy, your access control policy and your incident response plan. The free templates online are written for a 2,000-person company or for an auditor, so nobody reads them and nobody follows them. A policy that is not followed is worse in an audit than one that does not exist.
    </p>
  </Section>

  <Section id="inside" title="What is in the pack" lede="Written once, for a company your size, and reused by every alimi service. Each policy maps to requirements by criterion ID only; no framework text is copied in.">
    <ol class="questions" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,18rem),1fr))">
      {list.map((pol) => (
        <li>
          <span class="muted small">{pol.id}</span>
          <span>{pol.title}</span>
        </li>
      ))}
    </ol>
    <p class="measure" style="margin-top:1.5rem">Every file carries the line <em>Template. Adapt before adopting. Sections marked [HR or legal review] need a human reviewer.</em> The policies set the rules; a Massachusetts attorney and your HR lead sign off on the parts the law touches.</p>
  </Section>

  <Section id="how" tone="alt" title="How it works">
    <Steps steps={steps} />
  </Section>

  <Section id="pricing" title="Pricing">
    <Pricing product={p} />
  </Section>

  <Section id="waitlist" tone="alt" title="Join the waitlist" lede="The three free policies and the full library ship together. Leave your email and you will get the download link when it opens.">
    <WaitlistForm name="waitlist-policy-pack" interest={p.name} title={`Waitlist: ${p.name}`} />
  </Section>
</Base>
