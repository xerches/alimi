---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Section from "../../components/Section.astro";
import { FRAMEWORK_LABELS } from "../../lib/config.js";
import { FREE_DOCS, freeDoc } from "../../lib/content.js";

export function getStaticPaths() {
  return FREE_DOCS.map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params;
const doc = freeDoc(slug);
const mapped = doc.requirements
  ? Object.entries(doc.requirements).filter(([, ids]) => ids && ids.length).map(([fw, ids]) => `${FRAMEWORK_LABELS[fw] ?? fw} (${ids.length})`)
  : [];
const description = `${doc.title}${doc.id ? ` (${doc.id})` : ""}, free from alimi: a ${doc.group.toLowerCase()} document written for a company of 10 to 200 people. Read it here, adapt it, then adopt it.`;
---

<Base title={doc.title} description={description} path={`/resources/${slug}`}>
  <Hero eyebrow={doc.group} title={doc.title}>
    <p class="lede">
      {doc.id && <span>{doc.id}{doc.version ? `, version ${doc.version}` : ""}. </span>}
      About {Math.round(doc.words / 100) * 100} words.
      {mapped.length > 0 && <span> Mapped by criterion ID to {mapped.join(", ")}.</span>}
    </p>
    <div class="actions document-actions">
      <a class="button button--secondary" href="/resources">All free resources</a>
      <a class="button button--primary" href="/resources#files">Get the editable file</a>
    </div>
  </Hero>

  <Section id="document" tight>
    <div class="document-wrap">
      <article class="document" set:html={doc.html} />
    </div>
  </Section>

  <Section id="next" tone="alt" title="Adopting it" lede="Placeholders such as the Security Lead and the Company become your names in the editable file. The platform tracks who has signed it and when it is next reviewed.">
    <div class="actions">
      <a class="button button--primary" href="/resources#files">Get the editable file</a>
      <a class="button button--secondary" href="/platform#policies">Policies in the platform</a>
    </div>
  </Section>
</Base>
