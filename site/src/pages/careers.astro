---
// Careers: not hiring, and the page says so, with the roles that come first when revenue allows.
// Added Nov 2, 2026.
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import { brand } from "../lib/config.js";

const roles = [
  { title: "A second compliance lead", text: "Someone who has run a SOC 2 or ISO 27001 program from the inside at a small company and can make the scoping calls with a customer in plain English. The first hire, once the accounts outgrow one person." },
  { title: "A part-time engineer", text: "Python and a web framework, a taste for read-only integrations and tests, and patience for the boring parts of evidence. Comes when the integrations list outgrows evenings and weekends." },
  { title: "A partner manager", text: "Someone who has sold through MSPs and brokers and knows what a referral partner needs to hear. Comes with the reseller programme's first dozen partners." },
];
---

<Base title="Careers" description="Careers at Alimi: not hiring yet, and honest about it. The roles that come first when revenue allows, and how to work with Alimi as a partner in the meantime." path="/careers">
  <Hero eyebrow="Careers" title="Who joins, and when">
    <p class="lede">{brand.display_name} is one founder building in the evenings until the first customers pay. There are no open roles, and this page will not pretend otherwise; here is what comes first when there are.</p>
    <div class="actions">
      <a class="button button--primary" href="/for-partners">Work with Alimi as a partner</a>
    </div>
  </Hero>

  <Section id="roles" tone="alt" title="The roles that come first">
    <div class="grid">
      {roles.map((r) => (
        <article class="card">
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section id="how" title="How it will work">
    <p class="measure">Remote-first from {brand.location}, with the rules on the <a href="/about#beliefs">About page</a> applied to how we work as much as to what we sell: plain English, published terms, honest claims, a person in the loop. If one of these roles is you, <a href="/contact">say so now</a>; the list of people who wrote first is the list that gets called first.</p>
  </Section>

  <Section id="next" tone="dark" title="In the meantime" lede="IT providers, brokers, CPAs and attorneys can work with Alimi today.">
    <div class="actions">
      <a class="button button--primary" href="/for-partners">For partners</a>
      <a class="button button--secondary" href="/contact">Introduce yourself</a>
    </div>
  </Section>
</Base>
