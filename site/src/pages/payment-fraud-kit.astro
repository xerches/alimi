---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Steps from "../components/Steps.astro";
import Pricing from "../components/Pricing.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import Todo from "../components/Todo.astro";
import { product } from "../lib/config.js";

const p = product("payment_fraud_kit");
const rules = [
  { title: "Call back a number already on file", text: "Never the number in the email that asked for the change, and never a reply to that email." },
  { title: "Two people approve", text: "Above the threshold you set, and on every change of bank details, no matter the amount." },
  { title: "Hold new details for 24 hours", text: "New or changed payment details wait a day before the first payment goes out." },
];
const steps = [
  { title: "Download the kit", text: "The procedure, the callback scripts, the staff poster, the 20-minute training video and the closing-day checklist. Fill in your threshold and your approvers." },
  { title: "Adopt the three rules in a week", text: "Print the poster by the accounts desk, run the training at one team meeting, and add the callback step to your payment-change form." },
  { title: "Drill it once a year", text: "The half-day workshop tailors the procedure to your firm and runs a drill, so the day a real request arrives it is routine." },
];
---

<Base title={p.name} description="A payment-change and wire verification procedure, callback scripts, a staff poster, a 20-minute training video and a closing-day checklist for Massachusetts real estate. Sold as a kit, taught in a half-day workshop." path={p.href}>
  <Hero eyebrow={p.name} title={p.tagline}>
    <p class="lede">A written payment-change and wire verification procedure, callback scripts for finance staff, a one-page poster, a 20-minute training video and a closing-day checklist for Massachusetts home buyers and sellers.</p>
    <div class="actions">
      <a class="button button--primary" href="#waitlist">Join the waitlist</a>
      <a class="button button--secondary" href="#pricing">See pricing</a>
    </div>
  </Hero>

  <Section id="complaint" tone="alt" title="The email looked right. The bank account was not.">
    <p class="measure">
      Business email compromise (BEC, a criminal writing from a real or look-alike mailbox) is a supplier who "changed banks", a managing partner who needs a wire before a flight, or closing instructions that arrive the night before. The FBI's Internet Crime Complaint Center counted 24,768 BEC complaints and $3.04 billion in reported losses in 2025, and 12,368 real estate fraud complaints. Banks rarely recover the money after 72 hours.
      <Todo note="confirm the figures against the current IC3 report each April and add one anonymised example from a partner conversation (prompt 11)" />
    </p>
  </Section>

  <Section id="rules" title="Three rules, written down" lede="The kit is a procedure, not a product. These are the rules it installs.">
    <div class="grid">
      {rules.map((r) => (
        <article class="card">
          <h3>{r.title}</h3>
          <p>{r.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section id="how" tone="alt" title="How it works">
    <Steps steps={steps} />
  </Section>

  <Section id="pricing" title="Pricing">
    <Pricing product={p} />
  </Section>

  <Section id="waitlist" tone="alt" title="Join the waitlist" lede="Finance teams and closing offices first. Tell us which you are.">
    <WaitlistForm name="waitlist-payment-fraud-kit" interest={p.name} title={`Waitlist: ${p.name}`}>
      <div class="field">
        <label for="waitlist-payment-fraud-kit-role">You are</label>
        <select id="waitlist-payment-fraud-kit-role" name="role">
          <option value="">Choose one</option>
          <option>A finance or accounts team</option>
          <option>A real estate closing attorney or title agent</option>
          <option>A real estate brokerage</option>
          <option>An owner or operations lead</option>
          <option>Something else</option>
        </select>
      </div>
    </WaitlistForm>
  </Section>
</Base>
