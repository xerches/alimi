---
import App from "../layouts/App.astro";
import Pill from "../components/Pill.astro";
import Bar from "../components/Bar.astro";
import { company, readiness, testCounts, monitoring, peopleCounts, taskCounts, controlCounts, controls, questionnaires, formatDate, formatDateTime, href } from "../lib/data.js";
import { posture, postureHistory, auditReadiness, scoreDefinitions } from "../lib/scores.js";
import { month, deadline, monthItems, monthCounts, monthLead, GROUP_LABEL } from "../lib/month.js";
import { sparkline } from "../lib/charts.js";

const counts = controlCounts();
const trend = testCounts.failing - testCounts.previous;
const lastRun = monitoring.runs.at(-1);
const groupTone = { fix: "danger", renew: "warning", decide: "info" };
const spark = sparkline(postureHistory.map((h) => h.score), { label: `Posture score over the last ${postureHistory.length} scans: ${postureHistory.map((h) => h.score).join(", ")}` });
---

<App title="Home" heading={company.short_name} path="/" section="home" eyebrow={month.label}
  description={`What ${company.short_name} does in ${month.label}: the items that move the insurer's evidence pack, both scores, and what changed since the last scan.`}
  lead={monthLead}>
  <a slot="actions" class="button secondary" href="/overview">Full overview</a>
  <a slot="actions" class="button" href="/owners">All tasks by owner</a>

  <div class="hero">
    <div class="countdown">
      <span class="big">{deadline.renewalDays}<small>days to renewal</small></span>
      <span class="sub">{company.insurance.carrier.replace(" (fictional)", "")} renews {formatDate(company.insurance.renewal)}. The broker wants the evidence pack by {formatDate(deadline.date)}, in {deadline.days} days.</span>
      <span class="mark">{monthCounts.insurer} of this month's {monthCounts.total} items are for that pack.</span>
    </div>
    <div class="tile score">
      <span class="label">Audit readiness · {auditReadiness.short}</span>
      <span class="value">{auditReadiness.percent}%</span>
      <Bar percent={auditReadiness.percent} label={`${auditReadiness.short} readiness ${auditReadiness.percent} percent`} />
      <span class="note">{scoreDefinitions.readiness} {auditReadiness.ok} of {auditReadiness.total} controls, {auditReadiness.remaining} to go.</span>
      <a href={href.framework("insurer")}>Requirements and controls</a>
    </div>
    <div class="tile score alt">
      <span class="label">Alimi Recommended Security Posture Score</span>
      <span class="value-row"><span class="value">{posture.score}<small>of 100</small></span><span set:html={spark} /></span>
      <span class="note">{scoreDefinitions.posture} {posture.earned} of {posture.possible} points, {postureHistory[0].score} on the first scan.</span>
      <a href="/frameworks#posture">How it is scored</a>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h2>This month</h2><span class="muted" style="font-size:.8125rem">Picked by what moves the {deadline.label}, then by what is overdue</span></div>
    <ol class="list todo">
      {monthItems.map((t) => (
        <li>
          <span class="grow">
            <a href={t.href}>{t.title}</a>
            <span class="meta"><strong>{t.ownerName}</strong>{t.due && <span data-overdue={String(t.overdue)}>{t.overdue ? `Overdue, due ${formatDate(t.due)}` : `Due ${formatDate(t.due)}`}</span>}{t.insurer && <span>For the insurer</span>}</span>
            <span class="why">{t.why}</span>
          </span>
          <Pill label={GROUP_LABEL[t.group]} tone={groupTone[t.group]} />
        </li>
      ))}
    </ol>
    <p class="muted" style="margin:.75rem 0 0;font-size:.8125rem">
      {monthCounts.byGroup.fix} to fix, {monthCounts.byGroup.renew} to renew, {monthCounts.byGroup.decide} to decide; {monthCounts.overdue} already overdue.
      {monthCounts.more > 0 && <span> {monthCounts.more} more this month on the <a href="/owners">owners page</a>.</span>} Each person also has their own list: policies to accept, training due, MFA to register.
    </p>
  </div>

  <div class="since">
    <strong>Since the last scan ({formatDateTime(monitoring.collectedAt)}):</strong>
    <span>{trend === 0 ? "no change" : trend > 0 ? `${trend} more failing` : `${-trend} fewer failing`}. {testCounts.failing} of {testCounts.automated} tests failing, {testCounts.first} were on the first scan. {lastRun.note} Next run {company.scan.schedule.toLowerCase()}.</span>
    <a href="/monitoring">Monitoring</a>
  </div>

  <div class="summary-line">
    <span><strong>{counts.ok}</strong> of {controls.length} controls Ok</span>
    <span><strong>{peopleCounts.compliant}</strong> of {peopleCounts.total} people compliant</span>
    <span><strong>{taskCounts.next30}</strong> tasks due in 30 days, <strong>{taskCounts.overdue}</strong> overdue</span>
    <span>Bank review <strong>{questionnaires.bank.drafted}</strong> of {questionnaires.bank.questions.length} answered, due {formatDate(company.customer_review.due)}</span>
    <a href="/overview">Full overview</a>
  </div>

  <h2>Frameworks on the account</h2>
  <div class="grid wide">
    {readiness.map((r) => (
      <div class="card">
        <div class="card-head">
          <h3><a href={href.framework(r.id)}>{r.short}</a></h3>
          <span class="muted">{r.target?.label}{r.target?.date ? `, ${formatDate(r.target.date)}` : ""}</span>
        </div>
        <p class="value" style="font-size:1.75rem;font-weight:700;margin:0">{r.percent}%</p>
        <Bar percent={r.percent} label={`${r.short} readiness ${r.percent} percent`} />
        <p class="muted" style="margin:0">{r.ok} of {r.controls.length} controls Ok · {r.remaining} remaining</p>
      </div>
    ))}
  </div>
</App>
