---
import App from "../../layouts/App.astro";
import Pill from "../../components/Pill.astro";
import { people, person, tasksFor, owners, formatDate, formatDateTime, href, company } from "../../lib/data.js";

export function getStaticPaths() {
  return people.map((p) => ({ params: { id: p.id } }));
}
const { id } = Astro.params;
const p = person(id);
const myTasks = tasksFor(p.id).filter((t) => t.kind === "person");
const owns = owners.find((o) => o.id === p.id);
const teamTasks = tasksFor(p.id).filter((t) => t.kind !== "person");
const roleKey = Object.entries(company.roles).find(([, pid]) => pid === p.id)?.[0];
---

<App title={p.name} path={`/people/${p.id}`} section="people" eyebrow={p.department} crumbs={[{ label: "People", href: "/people" }, { label: p.name }]}
  description={`${p.name}, ${p.title}: compliance checks, the tasks they owe, policies to accept, training, device and account.`}
  lead={`${p.title}${p.managerName ? `, reports to ${p.managerName}` : ""}. ${p.counted ? `Started ${formatDate(p.start_date)}.` : "Not a member of staff."}${roleKey ? ` Named ${roleKey} in the security roles.` : ""}`}>
  <Pill slot="actions" status={p.counted ? (p.compliant ? "compliant" : "not_compliant") : "ok"} label={p.counted ? undefined : "Provider"} />
  <a slot="actions" class="button secondary" href="/people">All people</a>

  <div class="grid two">
    <div class="card">
      <h2>Checks</h2>
      <ul class="list">
        {p.checks.map((c) => <li><span class="grow">{c.label}<span class="sub muted" style="display:block;font-size:.8125rem">{c.detail}</span></span>{c.ok ? <Pill label="Yes" tone="success" /> : <Pill label="No" tone="warning" />}</li>)}
      </ul>
    </div>
    <div class="card">
      <h2>My tasks</h2>
      <p class="muted" style="font-size:.8125rem;margin-top:0">What {p.name.split(" ")[0]} sees after logging in. Each task has a button that opens the policy, the course or the MFA setup page.</p>
      {myTasks.length ? <ul class="list">{myTasks.map((t) => <li><span class="grow">{t.title}</span><span class="when" data-overdue={String(t.overdue)}>{t.due ? (t.overdue ? `Overdue, ${formatDate(t.due)}` : `Due ${formatDate(t.due)}`) : ""}</span></li>)}</ul> : <p style="margin:0">Nothing to do. Everything is current.</p>}
    </div>
  </div>

  <div class="grid two">
    <div class="card">
      <h2>Policies</h2>
      {p.pendingPolicies.length ? <><p class="muted" style="margin-top:0">{p.pendingPolicies.length} to accept:</p><ul class="list">{p.pendingPolicies.map((pol) => <li><span class="grow"><a href={href.policy(pol.id)}>{pol.title}</a> <span class="muted">v{pol.version}</span></span><button class="button small secondary" type="button">Read and accept</button></li>)}</ul></> : <p style="margin:0">All {p.counted ? "policies accepted on the current versions." : "applicable policies acknowledged under the provider agreement."}</p>}
    </div>
    <div class="card">
      <h2>Training</h2>
      {p.trainingRecords.length ? (
        <div class="table-wrap plain"><table><thead><tr><th>Course</th><th>Status</th><th>Completed</th><th>Due</th></tr></thead><tbody>
          {p.trainingRecords.map((t) => <tr><td>{t.course?.name}<span class="sub">{t.course?.minutes} minutes</span></td><td><Pill status={t.status} /></td><td>{t.completed ? formatDate(t.completed) : "—"}</td><td>{t.due ? formatDate(t.due) : "—"}</td></tr>)}
        </tbody></table></div>
      ) : <p class="muted" style="margin:0">No courses assigned.</p>}
    </div>
  </div>

  <div class="grid two">
    <div class="card">
      <h2>Account and device</h2>
      <dl class="kv">
        <dt>Account</dt><dd><span class="mono" style="word-break:break-all">{p.email}</span></dd>
        <dt>MFA</dt><dd>{p.mfa_registered ? "Registered (read from the tenant)" : "Not registered"}</dd>
        <dt>Groups</dt><dd>{p.groups.join(", ") || "—"}</dd>
        {p.deviceRecord && <><dt>Device</dt><dd>{p.deviceRecord.name}, {p.deviceRecord.os}, {p.deviceRecord.encryption}, {p.deviceRecord.edr ?? "no EDR"}; last check-in {formatDateTime(p.deviceRecord.last_check_in)}{p.deviceRecord.issue && <span class="sub">{p.deviceRecord.issue}</span>}</dd></>}
        <dt>Background check</dt><dd>{p.checks.find((c) => c.key === "background")?.detail}</dd>
      </dl>
    </div>
    <div class="card">
      <h2>Owns</h2>
      {owns ? <dl class="kv"><dt>Controls</dt><dd>{owns.controls.length}</dd><dt>Policies</dt><dd>{owns.policies.length}</dd><dt>Evidence</dt><dd>{owns.evidence.length}</dd><dt>Vendors</dt><dd>{owns.vendors.length}</dd><dt>Risks</dt><dd>{owns.risks.length}</dd><dt>AI tools</dt><dd>{owns.aiTools.length}</dd></dl> : <p class="muted" style="margin:0">Owns nothing in the program.</p>}
      {teamTasks.length ? <><h3>Team tasks due</h3><ul class="list">{teamTasks.slice(0, 8).map((t) => <li><span class="grow"><a href={t.href}>{t.title}</a></span><span class="when" data-overdue={String(t.overdue)}>{t.due ? formatDate(t.due) : ""}</span></li>)}</ul></> : null}
      {owns && <p style="margin:.5rem 0 0"><a href={`/owners#${p.id}`}>Owner view</a></p>}
    </div>
  </div>
</App>
