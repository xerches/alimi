---
import App from "../layouts/App.astro";
import Pill from "../components/Pill.astro";
import Bar from "../components/Bar.astro";
import { trust, company, formatDate, formatDateTime, href, policies } from "../lib/data.js";
---

<App title="Trust page" path="/trust" section="trust" eyebrow="Trust" crumbs={[{ label: "Trust page" }]}
  description="The public trust page the company shows a bank or a customer: posture summary, frameworks in progress, policies available on request, the insurer evidence pack and the subprocessor list."
  lead="What a customer, a bank or a broker sees without an account. It answers the first round of questions before anyone sends a questionnaire, and the evidence pack is one click behind a request.">
  <a slot="actions" class="button secondary" href="/questionnaires">Questionnaires</a>
  <a slot="actions" class="button" href="#pack">Evidence pack</a>

  <div class="callout" data-tone="neutral"><p>Below is the public page as a visitor would see it at trust.saltmarsh.example (fictional). Documents marked "on request" need the visitor's name and email and the owner's approval; nothing confidential is public.</p></div>

  <div class="public" style="border:1px solid var(--color-border);border-radius:.75rem;overflow:hidden">
    <div class="hero">
      <div class="inner">
        <span class="eyebrow" style="color:var(--color-text-inverse-muted)">Security at {company.short_name}</span>
        <h2 style="color:var(--color-text-inverse);font-size:1.75rem">How we protect the payroll data of 300 employers</h2>
        <p>{company.name} runs a documented security program on the Alimi platform: written policies staff accept every year, controls tested every week against our Microsoft 365 environment, encrypted devices, verified payments, and a fractional security lead who answers your questions. Last automated check: {formatDateTime(trust.lastScan)}.</p>
      </div>
    </div>
    <div class="body">
      <h3>Frameworks</h3>
      <div class="grid wide">
        {trust.frameworks.map((f) => <div class="card" style="margin:0"><strong>{f.short}</strong><div class="muted" style="font-size:.8125rem">{f.target?.label}</div><Bar percent={f.percent} label={`${f.short} ${f.percent} percent`} /><span class="muted" style="font-size:.8125rem">{f.percent}% of controls in place</span></div>)}
      </div>

      <h3>Policies available on request</h3>
      <p class="muted" style="font-size:.8125rem">{trust.publishedPolicies.length} published policies. Request a copy and the owner approves access within one business day.</p>
      <ul class="list">
        {trust.publishedPolicies.map((p) => <li><span class="grow">{p.title} <span class="muted">v{p.version}, {formatDate(p.approved)}</span></span><button class="button small secondary" type="button">Request</button></li>)}
      </ul>

      <h3 id="pack">Insurer evidence pack</h3>
      <p class="muted" style="font-size:.8125rem">What the broker receives for the renewal: {trust.pack.length} dated documents, each tied to a control and a question. Shared with a bank or a customer on request.</p>
      <div class="table-wrap plain"><table><thead><tr><th>Document</th><th>Type</th><th>Dated</th><th>Status</th></tr></thead><tbody>
        {trust.pack.map((e) => <tr><td>{e.name}</td><td>{e.type}</td><td>{formatDate(e.created)}</td><td><Pill status={e.status} /></td></tr>)}
      </tbody></table></div>
      <p style="margin-top:.75rem"><button class="button" type="button">Request access to the pack</button> <span class="demo-note">Demo: does nothing</span></p>

      <h3>Subprocessors</h3>
      <p class="muted" style="font-size:.8125rem">Vendors that handle your employees' data on our behalf, each under contract and reviewed every year.</p>
      <div class="table-wrap plain"><table><thead><tr><th>Subprocessor</th><th>Purpose</th><th>Data</th><th>Last review</th></tr></thead><tbody>
        {trust.subprocessors.map((v) => <tr><td>{v.name}{v.fictional ? <span class="sub">fictional vendor</span> : null}</td><td>{v.category}</td><td>{v.data_shared.join(", ")}</td><td>{v.last_review ? formatDate(v.last_review) : "In progress"}</td></tr>)}
      </tbody></table></div>

      <h3>Contact</h3>
      <p>Security questions: {trust.contact.name}, {trust.contact.title}. Incidents: the incident response contacts in our agreement with you. We tell affected customers within the deadlines in our contracts and the law.</p>
    </div>
  </div>

  <p class="muted" style="margin-top:1.25rem">In the app, the owner decides what is public, what is on request and what stays private; the page updates itself from the same data as the rest of the platform. Published policies: {policies.filter((p) => p.status === "published").length}.</p>
</App>
