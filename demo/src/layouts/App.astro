---
// The demo's page shell (layout chosen Nov 3, 2026): brand tokens inlined from config/brand.yaml, the
// sample-company banner on every page, the captioned icon strip on the left, a second column only
// where the section has children, and a top bar with the company switcher, breadcrumbs and the viewer.
// Every page passes its own path because build.format "file" makes Astro.url.pathname end in .html.
import "../styles/app.css";
import { brand } from "../lib/config.js";
import { cssVariables } from "../lib/tokens.js";
import { company, formatDate, person } from "../lib/data.js";
import { resolveSection } from "../lib/nav.js";
import Strip from "../components/Strip.astro";
import Column from "../components/Column.astro";

const { title, heading, description, path, section, item, eyebrow, lead, crumbs = [], wide = false } = Astro.props;
if (!path) throw new Error("App layout needs a path prop");
const resolved = resolveSection(section, item);
const hasColumn = Boolean(resolved.section.column);
const origin = String(Astro.site).replace(/\/$/, "");
const fullTitle = path === "/" ? `${company.short_name} on Alimi (demo)` : `${title} | ${company.short_name} on Alimi`;
const viewer = person(company.roles["AI Lead"]);
const initials = viewer.name.split(" ").map((w) => w[0]).join("");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={origin + path} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={brand.colors.background_dark} />
    <style is:inline set:html={cssVariables(brand)}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <Strip section={resolved.section.key} />
      <div class="content" data-column={hasColumn || undefined}>
        <div class="sample-banner" data-sample-banner>
          <strong>Sample company.</strong>
          <span>{company.name} is fictional. Static data as of {formatDate(company.as_of)}; nothing here was read from a real tenant.</span>
        </div>
        <div class="topbar">
          <div class="company-switch" aria-label={`Company: ${company.short_name}`} title="A reseller switches between clients here; a multi-entity customer between entities">
            <div><strong>{company.short_name}</strong><span>{company.location.split(",")[0]} · {company.headcount} people</span></div>
            <span class="chev" aria-hidden="true">▾</span>
          </div>
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            {crumbs.map((crumb) => (<><span aria-hidden="true">/</span>{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}</>))}
          </nav>
          <div class="who"><span>Viewing as {viewer.name}, {viewer.title}</span><span class="avatar" aria-hidden="true">{initials}</span></div>
        </div>
        {hasColumn && <Column section={resolved.section} item={resolved.item} />}
        <main id="main" style={wide ? "max-width:none" : undefined}>
          <div class="page-header">
            <div>
              {eyebrow && <span class="eyebrow">{eyebrow}</span>}
              <h1>{heading ?? title}</h1>
              {lead && <p class="lead">{lead}</p>}
            </div>
            <div class="actions"><slot name="actions" /></div>
          </div>
          <slot />
          <p class="foot">Alimi demo. {company.name} is a fictional sample company; people, vendors, dates and numbers are invented. Policies, requirement IDs, controls and checks are Alimi's real content.</p>
        </main>
      </div>
    </div>
    <script>
      import "../scripts/enhance.js";
    </script>
  </body>
</html>
